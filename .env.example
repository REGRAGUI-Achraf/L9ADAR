# Copy this file to .env and fill in the blanks. Never commit .env.

# Project
# The address of the site. Used for links and the Google callback
PUBLIC_ORIGIN=https://localhost

# PostgresSQL
POSTGRES_DB=l9adar
POSTGRES_USER=l9adar
# Letters and digits only: it is placed inside a connection URL.
POSTGRES_PASSWORD=

# Backend
#  Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
UPLOAD_MAX_MB=5

# Google sing-in (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI service (only needed for RAG)
LLM_API_KEY=



