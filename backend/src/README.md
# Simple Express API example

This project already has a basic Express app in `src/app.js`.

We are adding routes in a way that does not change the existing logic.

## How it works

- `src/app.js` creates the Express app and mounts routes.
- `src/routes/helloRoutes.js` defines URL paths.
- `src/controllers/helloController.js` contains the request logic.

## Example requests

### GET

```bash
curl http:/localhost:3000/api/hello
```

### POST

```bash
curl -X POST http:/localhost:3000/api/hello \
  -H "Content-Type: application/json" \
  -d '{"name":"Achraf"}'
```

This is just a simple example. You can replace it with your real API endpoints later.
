const express = require('express');
const {
  getHello,
  postHello
} = require('../controllers/helloController');

// This is a small route file.
// It separates the URL definitions from the logic.
const router = express.Router();

// GET /api/hello
// This route calls the controller function getHello.
router.get('/hello', getHello);

// POST /api/hello
// This route calls the controller function postHello.
router.post('/hello', postHello);

module.exports = router;
